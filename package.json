{
  "name": "gachamod",
  "private": true,
  "version": "0.1.1-beta.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:attach": "tauri dev --config src-tauri/tauri.attach.conf.json",
    "installer": "node scripts/build-installer.mjs",
    "release": "node scripts/release.mjs",
    "build:setup": "vite build --config vite.setup.config.ts",
    "setup": "cargo run -p gachamod-setup --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
