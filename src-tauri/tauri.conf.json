{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gachamod",
  "version": "0.1.1-beta.17",
  "identifier": "app.gachamod.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "gachamod",
        "width": 1400,
        "height": 880,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: asset: http://asset.localhost; media-src 'self' https: asset: http://asset.localhost; frame-src https://www.youtube-nocookie.com https://www.youtube.com http://gmext.localhost gmext:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://raw.githubusercontent.com https://gamebanana.com https://*.gamebanana.com https://api.github.com https://*.fandom.com https://*.wiki.gg https://iopwiki.com https://itunes.apple.com",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "imanimal",
    "homepage": "https://github.com/imanimal/gachamod",
    "shortDescription": "Mod manager for 3DMigoto model importer games",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["gachamod"], "name": "gachamod pack", "description": "Mods packed by gachamod", "role": "Editor", "mimeType": "application/x-gachamod" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "uninstallerHeaderImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4NUFFRTkyRERGQkE2QzcKUldUSHB2dmRrdTVhR08raXVTRFNDODZjZW9UNnNCbDNBeE10ZURTejlKZFFVb0piejRmTWdZQVMK",
      "endpoints": ["https://github.com/imanimal/gachamod/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
