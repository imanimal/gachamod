{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gachamod",
  "version": "0.1.0",
  "identifier": "app.gachamod.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gachamod",
        "width": 1400,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: asset: http://asset.localhost; media-src 'self' https: asset: http://asset.localhost; frame-src https://www.youtube-nocookie.com https://www.youtube.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://gamebanana.com https://*.gamebanana.com https://api.github.com",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["gachamod"], "name": "gachamod pack", "description": "Mods packed by gachamod", "role": "Editor", "mimeType": "application/x-gachamod" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
